{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timecard-promotion-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "timecard-promotion-test",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "4502d1be-66d8-4735-b2b7-35528aa22334",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "timecard-promotion-test","preview_bucket_name": "timecard-promotion-test",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
